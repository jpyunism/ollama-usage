<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_plan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_session_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_session_label"
        android:textAllCaps="true"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_session"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Semáforo (REQ-021): las tres barras van pre-tintadas y el provider
             alterna su visibilidad. No se puede cambiar el drawable en runtime
             porque ProgressBar#setProgressDrawable NO es @RemotableViewMethod
             (RemoteViews lanza ActionException y el launcher muestra
             "Couldn't add widget"); tampoco setProgressTintList, que necesita
             RemoteViews#setColorStateList (API 31) con minSdk 26. La visibilidad
             sí es una acción permitida en todas las versiones soportadas. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_gravity="center_vertical">

            <ProgressBar
                android:id="@+id/widget_progress_green"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress_green"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_progress_amber"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress_amber"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_progress_red"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress_red"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_session_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
