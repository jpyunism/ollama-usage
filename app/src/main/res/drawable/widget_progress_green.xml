<?xml version="1.0" encoding="utf-8"?>
<!-- Variante verde del semáforo (Feature C): clip tintado por nivel.
     El provider elige el drawable según TrafficLight.paceColor() porque
     RemoteViews#setColorStateList requiere API 31 (minSdk 26). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/widget_progress_bg" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle">
                <corners android:radius="5dp" />
                <solid android:color="#FF2E7D32" />
            </shape>
        </clip>
    </item>
</layer-list>